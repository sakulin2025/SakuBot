SAKUBOT_BASE_IMAGE=python:3.13-slim
SAKUBOT_BIND=0.0.0.0
SAKUBOT_PORT=6190
# start.sh automatically uses the current user's UID/GID for the bind mount.
# Compose variables belong in ~/ContainerService/napcat/.env or the shell environment.
SAKUBOT_SOURCE=/Users/sakulin/KeepCoding/sakubot
SAKUBOT_COMPOSE_FILE=/Users/sakulin/ContainerService/napcat/docker-compose.yml
SAKUBOT_RUNTIME_DATA=/Users/sakulin/ContainerService/napcat/data/sakubot
