{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["vite/client"],
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": { "@sakubot/ui": ["./src/plugin-sdk/index.ts"], "vue": ["./node_modules/vue"] },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "../sakubot/plugins/*/web/src/**/*.ts",
    "../sakubot/plugins/*/web/src/**/*.vue"
  ]
}
