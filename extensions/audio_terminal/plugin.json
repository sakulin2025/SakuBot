{
  "name": "audio_terminal",
  "label": "音频终端",
  "version": "0.5.0",
  "icon": "connection",
  "settings": {
    "fields": [
      {
        "key": "base_url",
        "label": "服务地址",
        "type": "string",
        "required": true,
        "format": "http-url",
        "default": "http://esp32-audio-terminal:8765",
        "placeholder": "http://esp32-audio-terminal:8765"
      },
      {
        "key": "default_device",
        "label": "主动说话默认设备ID（唯一在线设备可留空）",
        "type": "string",
        "default": ""
      },
      {
        "key": "token",
        "label": "API_TOKEN",
        "type": "secret",
        "required": true,
        "default": "",
        "placeholder": "粘贴音频终端服务的 API_TOKEN"
      },
      {
        "key": "subscribe_events",
        "label": "订阅设备事件",
        "type": "boolean",
        "default": true
      },
      {
        "key": "conversation_enabled",
        "label": "提供主会话对话能力",
        "type": "boolean",
        "default": true
      },
      {
        "key": "speech_backend",
        "label": "语音处理方式",
        "type": "select",
        "default": "bridge",
        "options": [
          {
            "value": "bridge",
            "label": "音频服务 ASR/TTS（兼容模式）"
          },
          {
            "value": "models",
            "label": "Sakubot 模型 ASR/TTS（分句流式播放）"
          }
        ]
      },
      {
        "key": "asr_model_id",
        "label": "ASR 模型",
        "type": "select",
        "default": ""
      },
      {
        "key": "tts_model_id",
        "label": "TTS 模型",
        "type": "select",
        "default": ""
      },
      {
        "key": "auto_interrupt",
        "label": "新语音自动打断当前回答（保留会话）",
        "type": "boolean",
        "default": true
      },
      {
        "key": "tts_voice",
        "label": "模型 TTS 音色（留空使用模型默认）",
        "type": "string",
        "default": "",
        "max_length": 200
      },
      {
        "key": "tts_instruction",
        "label": "模型 TTS 风格要求",
        "type": "text",
        "default": "",
        "max_length": 2000
      },
      {
        "key": "activity_cues",
        "label": "思考与工具提示音（播报开始后停用）",
        "type": "boolean",
        "default": false
      },
      {
        "key": "temporary_context",
        "label": "音箱主会话临时上下文",
        "type": "text",
        "default": "你正在通过音箱与用户对话，回答会自动合成语音播放。\n请简短、直接、口语化地回答，通常控制在1到3句话；除非用户明确要求详细说明，不要长篇解释或输出大段列表。\n用户明确要求结束本次对话，或说“再见”“不用聊了”等告别语时，必须调用 audio_terminal_end_conversation，无需填写任何参数。不能只口头答应，也不要让用户等待会话自动超时。\n仅要求停止播放不等于结束对话；用户仍希望继续交流时不要擅自结束会话。",
        "max_length": 8000,
        "placeholder": "对音箱主会话的回答风格、会话结束工具调用等要求；每轮和每次模型调用都会提醒。"
      }
    ],
    "connection": {
      "path": "/v1/devices",
      "token_field": "token",
      "required_paths": [
        "devices"
      ]
    }
  }
}
